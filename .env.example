# Optional: enables real AI scene analysis. Keep this file's values empty in Git.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional server-only search waterfall. Missing keys are skipped.
# Wikipedia -> Tavily -> Exa -> SerpApi -> optional Brave. Free plans must be selected
# in each provider dashboard; leave paid billing/automatic top-ups disabled.
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
# Shared UTC-month request caps, separate from AI_DAILY_LIMIT. Failed attempts count.
# Conservative defaults; Exa credits are dollars, not a request allowance.
# Lens uses the SerpApi budget (upload and search each reserve one request).
TAVILY_MONTHLY_LIMIT=900
EXA_MONTHLY_LIMIT=300
SERPAPI_MONTHLY_LIMIT=200
# Brave is opt-in because this configuration is intended for free tiers.
BRAVE_MONTHLY_LIMIT=0
# Default: AI_USAGE_FILE with .search appended. Ephemeral hosting may reset counts;
# provider dashboard hard limits remain authoritative for avoiding charges.
SEARCH_USAGE_FILE=.data/search-usage.json
# Optional alternative: set AI_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required in production; use a private password of 16–200 characters.
AI_ACCESS_PASSWORD=
# Shared UTC-day allowance. Failed provider attempts also count. 0 pauses AI.
AI_DAILY_LIMIT=10
# Keep outside Git. Ephemeral hosting may clear this file and reset the allowance.
AI_USAGE_FILE=.data/ai-usage.json
# Required for production outside Render; Render supplies RENDER_EXTERNAL_URL automatically.
APP_ORIGIN=
# Local server. Production defaults to 0.0.0.0 and uses the hosting PORT.
HOST=127.0.0.1
PORT=8787
# Replace if operating a deployment with significant traffic.
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=Findwhere/1.0 (https://github.com/saad2jz/findwhere)
